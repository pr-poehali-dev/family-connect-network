# Скопируй этот файл в .env и заполни значения:
# cp .env.example .env

# ── База данных ───────────────────────────────────────────────────────────────
DB_USER=myapp_user
DB_PASSWORD=ПРИДУМАЙ_ПАРОЛЬ_ДЛЯ_БД
DB_NAME=myapp_db

# ── Первый администратор (создаётся автоматически) ────────────────────────────
ADMIN_NAME=Администратор
ADMIN_LOGIN=admin
ADMIN_PASSWORD=ПРИДУМАЙ_ПАРОЛЬ_АДМИНИСТРАТОРА

# ── Адрес сайта (IP сервера или домен) ────────────────────────────────────────
VITE_API_URL=http://ВАШ_IP_ИЛИ_ДОМЕН
